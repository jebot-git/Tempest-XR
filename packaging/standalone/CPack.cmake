if(DE_XR_STANDALONE)
 include(GNUInstallDirs)
 set(CPACK_PACKAGE_NAME "tempest-xr")
 set(DE_XR_RELEASE_VERSION "0.1.0.20261029" CACHE STRING "Standalone release version")
 set(CPACK_PACKAGE_VERSION "${DE_XR_RELEASE_VERSION}")
 set(CPACK_PACKAGE_RELEASE "1")
 set(CPACK_PACKAGE_VENDOR "de-xr contributors")
 set(CPACK_PACKAGE_CONTACT "https://github.com/jebot-git/Tempest-XR/issues")
 set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Standalone desktop and generic OpenXR game")
 set(CPACK_PACKAGING_INSTALL_PREFIX "${CMAKE_INSTALL_PREFIX}")
 set(CPACK_DEBIAN_PACKAGE_MAINTAINER "de-xr contributors")
 set(CPACK_DEBIAN_PACKAGE_SECTION "games")
 set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
 set(CPACK_DEBIAN_PACKAGE_DEPENDS "libopenmpt0")
 set(CPACK_RPM_PACKAGE_REQUIRES "libopenmpt")
 set(CPACK_RPM_PACKAGE_LICENSE "LicenseRef-Original-Game-Rights")
 set(CPACK_RPM_PACKAGE_GROUP "Amusements/Games")
 set(CPACK_RPM_PACKAGE_AUTOREQPROV ON)
 set(CPACK_RPM_EXCLUDE_FROM_AUTO_FILELIST_ADDITION /usr/libexec /usr/share/icons /usr/share/icons/hicolor /usr/share/applications)
 set(CPACK_GENERATOR "TGZ")
 install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/THIRD_PARTY_NOTICES.md" DESTINATION share/licenses/tempest-xr)
 install(FILES "${CMAKE_CURRENT_LIST_DIR}/README.md" DESTINATION share/doc/tempest-xr RENAME STANDALONE.md)
 if(DE_XR_BUILD_INFO)
  install(FILES "${DE_XR_BUILD_INFO}" DESTINATION share/doc/tempest-xr RENAME BUILD.json)
 endif()
 include(CPack)
endif()
